---
import { Image } from 'astro:assets';
import Scribble from './Scribble.astro';
import portrait from '../assets/david.jpg';
import { hero } from '../data/site';

// Split each headline line on *asterisks*; odd segments are the green word(s).
const lines = hero.headline.map((line) => line.split('*'));
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="text">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1 id="hero-title">
      {lines.map((parts, i) => (
        <>
          {parts.map((part, j) => (j % 2 === 1 ? <em>{part}</em> : part))}
          {i < lines.length - 1 && <br />}
        </>
      ))}
    </h1>
    <p class="lede">{hero.lede}</p>
    {hero.pen && <span class="pen">{hero.pen}</span>}
    <div class="actions">
      <a class="btn primary" href={hero.primary.href}>{hero.primary.label}</a>
      <a class="btn" href={hero.secondary.href}>{hero.secondary.label}</a>
    </div>
  </div>

  <figure class="photo">
    <Scribble animate class="hero-scribble" />
    <div class="frame">
      <Image
        src={portrait}
        alt={hero.photoAlt}
        widths={[380, 760, 1140]}
        sizes="(max-width: 760px) 320px, 380px"
        format="webp"
        quality={78}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <figcaption class="eyebrow">{hero.photoCaption}</figcaption>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    padding-block: clamp(48px, 8vw, 112px);
  }
  .text {
    display: grid;
    gap: 18px;
    min-width: 0;
  }
  .text .eyebrow {
    color: var(--ink);
  }
  h1 {
    font-size: clamp(44px, 7vw, 92px);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  h1 em {
    font-style: normal;
    color: var(--grass-deep);
  }
  .lede {
    max-width: 42ch;
    font-size: 17px;
    color: var(--ink-2);
  }
  .actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 6px;
  }
  .photo {
    position: relative;
    margin: 0;
    justify-self: end;
    width: min(100%, 380px);
    display: grid;
    gap: 10px;
  }
  .photo .frame {
    aspect-ratio: 4 / 5;
    width: 100%;
    border: 1px solid var(--ink);
    overflow: hidden;
    background: var(--paper-2);
  }
  .photo .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    filter: saturate(0.92) contrast(1.04);
  }
  .photo :global(.hero-scribble) {
    left: -30%;
    top: -18%;
    width: 64%;
    height: 44%;
    z-index: 1;
  }
  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .photo {
      justify-self: start;
      width: min(100%, 320px);
    }
    .photo :global(.hero-scribble) {
      left: -6%;
      top: -8%;
    }
  }
</style>
