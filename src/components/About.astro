---
import Scribble from './Scribble.astro';
import { about, sections } from '../data/site';
---

<section class="section container about" id="about" aria-labelledby="about-title">
  <div class="section-head reveal">
    <h2 id="about-title">{sections.about}</h2>
    <span class="label">( about )</span>
  </div>

  <div class="cols">
    <div class="prose reveal">
      {about.paragraphs.map((text) => <p>{text}</p>)}
      {about.pen && <span class="pen">{about.pen}</span>}
    </div>

    <aside class="side reveal">
      <div class="slot small">
        <Scribble class="about-scribble" />
        <span class="slot-label">{about.photoLabel.split('\n').map((l, i) => <>{i > 0 && <br />}{l}</>)}</span>
      </div>
      <dl class="facts">
        {about.facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>
              {f.bars && <span class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>}
              {f.value}
            </dd>
          </div>
        ))}
      </dl>
    </aside>
  </div>
</section>

<style>
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }
  .prose {
    display: grid;
    gap: 18px;
    max-width: var(--measure);
  }
  .prose .pen {
    margin-top: 8px;
  }
  .side {
    display: grid;
    gap: 20px;
    max-width: 320px;
  }
  .slot.small {
    aspect-ratio: 1;
    width: 100%;
  }
  .side :global(.about-scribble) {
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .facts {
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .facts div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 12px;
    align-items: baseline;
    padding-top: 10px;
    border-top: 1px solid var(--line);
  }
  dt {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--mute);
  }
  dd {
    margin: 0;
    font-size: 15px;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .bars {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 14px;
  }
  .bars i {
    width: 3px;
    background: var(--grass);
    border-radius: 1px;
    animation: eq 1.1s ease-in-out infinite;
  }
  .bars i:nth-child(1) { height: 40%; }
  .bars i:nth-child(2) { height: 90%; animation-delay: 0.15s; }
  .bars i:nth-child(3) { height: 60%; animation-delay: 0.3s; }
  .bars i:nth-child(4) { height: 100%; animation-delay: 0.45s; }
  @keyframes eq {
    50% { transform: scaleY(0.35); }
  }
  @media (max-width: 760px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bars i {
      animation: none;
    }
  }
</style>
