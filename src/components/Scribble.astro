---
/**
 * A thin pen scribble drawn on a canvas. Generative, so every visit gets a
 * slightly different tangle. `animate` draws it in over ~2s on load.
 */
interface Props {
  animate?: boolean;
  class?: string;
}
const { animate = false, class: className = '' } = Astro.props;
---

<canvas class:list={['scribble', className]} data-scribble={animate ? 'animate' : 'static'} aria-hidden="true"></canvas>

<style>
  .scribble {
    position: absolute;
    pointer-events: none;
    mix-blend-mode: multiply;
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function draw(canvas: HTMLCanvasElement, animate: boolean) {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    if (!w || !h) return;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.scale(dpr, dpr);
    ctx.strokeStyle = '#111';
    ctx.lineWidth = 0.8;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.globalAlpha = 0.85;

    const cx = w * 0.5;
    const cy = h * 0.5;
    const rx = w * 0.26;
    const ry = h * 0.28;
    const n = Math.round(22 + Math.min(w, h) / 14);
    const pts: [number, number][] = [];
    let a = Math.random() * Math.PI * 2;
    for (let i = 0; i < n; i++) {
      a += 1.9 + Math.random() * 1.6;
      const r = 0.35 + Math.random() * 0.75;
      pts.push([
        cx + Math.cos(a) * rx * r + (Math.random() - 0.5) * 20,
        cy + Math.sin(a) * ry * r + (Math.random() - 0.5) * 20,
      ]);
    }
    // a tail leaving the tangle
    pts.push([cx + rx * 1.2, cy + ry * 0.9]);
    pts.push([cx + rx * 1.55, cy + ry * 1.5]);

    const strokeTo = (limit: number) => {
      ctx.clearRect(0, 0, w, h);
      ctx.beginPath();
      ctx.moveTo(pts[0][0], pts[0][1]);
      for (let i = 1; i < limit && i < pts.length - 1; i++) {
        const mx = (pts[i][0] + pts[i + 1][0]) / 2;
        const my = (pts[i][1] + pts[i + 1][1]) / 2;
        ctx.quadraticCurveTo(pts[i][0], pts[i][1], mx, my);
      }
      ctx.stroke();
    };

    if (!animate || reduce) {
      strokeTo(pts.length);
      return;
    }
    let start: number | null = null;
    const dur = 2000;
    const frame = (ts: number) => {
      if (start === null) start = ts;
      const k = Math.min(1, (ts - start) / dur);
      strokeTo(Math.floor(pts.length * k));
      if (k < 1) requestAnimationFrame(frame);
      else strokeTo(pts.length);
    };
    requestAnimationFrame(frame);
  }

  const canvases = document.querySelectorAll<HTMLCanvasElement>('canvas[data-scribble]');
  const run = (animate: boolean) =>
    canvases.forEach((c) => draw(c, animate && c.dataset.scribble === 'animate'));

  if (document.fonts?.ready) document.fonts.ready.then(() => run(true));
  else run(true);

  let t: number | undefined;
  window.addEventListener('resize', () => {
    clearTimeout(t);
    t = window.setTimeout(() => run(false), 200);
  });
</script>
