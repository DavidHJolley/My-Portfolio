---
import { links, contact, sections } from '../data/site';
---

<section class="section container contact" id="contact" aria-labelledby="contact-title">
  <div class="section-head reveal">
    <h2 id="contact-title">{sections.contact}</h2>
    <span class="label">( contact )</span>
  </div>

  <div class="row reveal">
    <p class="big"><a href={`mailto:${contact.email}`}>{contact.email}</a></p>
    <ul class="links">
      {links.map((l) => (
        <li><a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    flex-wrap: wrap;
  }
  .big {
    font-size: clamp(24px, 4vw, 44px);
    letter-spacing: -0.03em;
    color: var(--ink);
    font-weight: 300;
    overflow-wrap: anywhere;
  }
  .big a {
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .big a:hover,
  .big a:focus-visible {
    border-color: var(--ink);
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 22px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.14em;
  }
  .links a {
    color: var(--ink);
    text-decoration: none;
  }
  .links a:hover,
  .links a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 6px;
  }
</style>
